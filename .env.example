# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
# Create these in cPanel > MySQL Databases first, then fill in below.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_mysql_user
DB_PASSWORD=your_cpanel_mysql_password
DB_NAME=yeti_homes
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# ── API Server ───────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed CORS origins (your frontend domains)
CORS_ORIGINS=https://admin.yourdomain.com,https://yourfrontend.com

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate secrets:  openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_random_base64_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_base64_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP Email (for contact/enquiry forms) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Yeti Homes <noreply@yetihomes.com>
ADMIN_EMAIL=info@yetihomes.com

# ── Admin Panel (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

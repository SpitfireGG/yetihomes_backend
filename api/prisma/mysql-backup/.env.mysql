PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL="mysql://postgres:postgres@localhost:3306/yeti_homes"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Yeti Homes <noreply@yetihomes.com>
ADMIN_EMAIL=info@yetihomes.com

# JWT Configuration
JWT_ACCESS_SECRET=change-me-to-a-random-base64-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-base64-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
